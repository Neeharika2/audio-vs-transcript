# Copy this file to .env and fill in your own keys.
# .env is git-ignored; do not commit real secrets.

# Google AI Studio key (optional; approach_1 fallback judge)
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek API key (approach_1 evaluator judge)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Deepgram API key (approach_2 engine B)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# --- approach_1 (optional) ---
# STT_MODEL_NAME=base
# EVAL_MODEL_NAME=deepseek-v4-flash
# EMBEDDINGS_ENABLED=true
# SCORE_THRESHOLD=90

# --- approach_2 (optional) ---
# GEMINI_MODEL=gemini-3.5-flash
# GLOSSARY_PATH=