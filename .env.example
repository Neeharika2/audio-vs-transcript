# Copy this file to .env and fill in your own keys.
# .env is git-ignored; do not commit real secrets.

# Google AI Studio key (approach_1 evaluator, approach_2 LLM judge)
GEMINI_API_KEY=your_gemini_api_key_here

# Deepgram API key (approach_2 engine B)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# --- approach_1 (optional) ---
# STT_MODEL_NAME=base
# EVAL_MODEL_NAME=gemini-3.5-flash
# EMBEDDINGS_ENABLED=true
# SCORE_THRESHOLD=90

# --- approach_2 (optional) ---
# GEMINI_MODEL=gemini-3.5-flash
# GLOSSARY_PATH=